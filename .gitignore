.env
.env.local
config/database.local.php

# --------------------------------------------
# Uploads temporários dos usuários (arquivos gerados pelo upload)
# Formato: uniqid() gera nomes hexadecimais como "6ac57b4604917.png"
# --------------------------------------------
assets/img/animais/6ac*.png
assets/img/animais/6ac*.jpg
assets/img/animais/6ac*.jpeg
assets/img/animais/6ac*.gif
assets/img/animais/6ac*.webp

# --------------------------------------------
# Backups locais do banco
# --------------------------------------------
database/petamigo_bd.sql
database/*_backup.sql
database/backup_*.sql

